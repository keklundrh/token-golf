# Token Golf - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# Application Environment
# ============================================================================
ENV=development
LOG_LEVEL=info

# ============================================================================
# Database Configuration
# ============================================================================
# For local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/token_golf.db

# For PostgreSQL (production-like testing)
# Uncomment and run with: docker-compose --profile postgres up
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/token_golf
# POSTGRES_DB=token_golf
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Claude API (for local development)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-haiku-4.5-20251001

# OpenShift AI (for production - not used in MVP)
# OPENSHIFT_AI_URL=https://your-openshift-ai-endpoint
# OPENSHIFT_AI_TOKEN=your-token-here

# ============================================================================
# Game Configuration
# ============================================================================
# Session timeout in hours (default: 3)
SESSION_TIMEOUT_HOURS=3

# Maximum iterations per challenge (optional limit)
MAX_ITERATIONS_PER_CHALLENGE=10

# Number of challenges to preload
PRELOAD_CHALLENGES=true

# ============================================================================
# Security & Sessions
# ============================================================================
# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# CORS settings (for frontend, if needed)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ============================================================================
# Development Tools
# ============================================================================
# Enable debug mode (verbose logging, detailed errors)
DEBUG=false

# Enable API documentation (/docs endpoint)
ENABLE_DOCS=true

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Log format: json or text
LOG_FORMAT=text

# Sentry DSN (for error tracking - optional)
# SENTRY_DSN=https://your-sentry-dsn-here
